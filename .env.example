# Nomor owner dalam format internasional, dipisah koma bila lebih dari satu.
OWNER=
# Chat teks dan transkripsi audio; fitur terkait gagal bila kunci kosong.
GROQ_API_KEY=
# Analisis gambar.
OPENROUTER_API_KEY=

# Model harus tersedia pada penyedia masing-masing.
AI_TEXT_MODEL=openai/gpt-oss-120b
AI_VISION_MODEL=openai/gpt-4.1-mini
AI_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
AI_TEXT_MAX_TOKENS=2048
AI_VISION_MAX_TOKENS=1200
# 0–2 percobaan ulang untuk 429/gangguan sementara; timeout tidak diulang.
AI_MAX_RETRIES=1
# Sisi terpanjang gambar, 512–4096 piksel.
AI_IMAGE_MAX_DIMENSION=2048
# id untuk bahasa Indonesia, auto untuk deteksi bahasa otomatis.
VOICE_LANGUAGE=id
VOICE_TRANSCRIPTION_PROMPT=Percakapan bahasa Indonesia. Nama asisten ME-AI, dibuat oleh Chairul.
TTS_VOICE=id-ID-ArdiNeural
# Default ketat: hanya endpoint OpenRouter ZDR; pengumpulan data selalu deny.
OPENROUTER_ZDR=true
